{
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2021",
    "lib": ["ES2021"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "declaration": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@/*": ["apps/api/src/*"]
    }
  },
  "include": ["tests/**/*.ts", "apps/api/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
