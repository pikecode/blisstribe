# BlissTribe Docker 部署环境变量示例
# 复制为 .env.production 后按环境修改。不要提交真实生产密钥。

NODE_ENV=production

# Docker Compose 内部使用服务名访问依赖，不使用 localhost。
DATABASE_URL=postgresql://blisstribe:blisstribe@postgres:5432/blisstribe?schema=public
REDIS_URL=redis://redis:6379

PORT=4000
UPLOAD_DIR=/app/uploads
PUBLIC_BASE_URL=http://localhost:14000
CORS_ORIGIN=http://localhost

JWT_ACCESS_SECRET=change-me-access-secret-32chars
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars
ACCESS_TOKEN_EXPIRES=2h
REFRESH_TOKEN_EXPIRES=7d

RSA_PRIVATE_KEY=change-me
RSA_PUBLIC_KEY=change-me

WX_APP_ID=
WX_APP_SECRET=
